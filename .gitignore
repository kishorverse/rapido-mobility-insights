# --- Generated artefacts (regenerate with the scripts in src/) ------------- #
# The model-ready feature table is ~52 MB and derived entirely from data/raw/.
# Rebuild with: python src/feature_engineering.py build --rebuild
data/processed/*.csv

# Trained model binaries: rebuild with `python src/train_models.py`.
# driver_delay_model.pkl alone is 47 MB, so the artefacts stay out of git --
# but the metrics they produced are kept so results are reviewable without a
# retrain, and reports/model_results.md is written from them.
models/*
!models/metrics.json

# --- Secrets --------------------------------------------------------------- #
.env
.streamlit/secrets.toml

# --- Python ---------------------------------------------------------------- #
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# --- Redundant source copies ----------------------------------------------- #
# The loaders read data/raw/*.csv; any Excel copies are the same data again.
*.xlsx

# --- OS / editor ----------------------------------------------------------- #
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
